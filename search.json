[{%- for p in site.posts -%}
{"title":{{ p.title | jsonify }},"url":{{ p.url | relative_url | jsonify }},"date":{{ p.date | date: "%Y.%m.%d" | jsonify }},"tags":{{ p.tags | jsonify }},"content":{{ p.content | strip_html | normalize_whitespace | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}]
